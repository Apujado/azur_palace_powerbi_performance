{
  "name": "Azur Palace Training Theme",
  "dataColors": [
    "#1F446C",
    "#D4AF37",
    "#5B84B1",
    "#2E5B88",
    "#F4D06F",
    "#8B9DC3",
    "#34495E",
    "#E67E22"
  ],
  "background": "#F8FAFC",
  "foreground": "#0F172A",
  "tableAccent": "#1F446C",
  "visualStyles": {
    "*": {
      "*": {
        "visualHeader": [
          {
            "show": true
          }
        ],
        "background": [
          {
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#E2E8F0"
              }
            }
          }
        ],
        "shadow": [
          {
            "show": false
          }
        ],
        "title": [
          {
            "fontColor": {
              "solid": {
                "color": "#0F172A"
              }
            }
          }
        ],
        "categoryAxis": [
          {
            "labelColor": { "solid": { "color": "#475569" } }
          }
        ],
        "valueAxis": [
          {
            "labelColor": { "solid": { "color": "#475569" } }
          }
        ]
      }
    }
  }
}