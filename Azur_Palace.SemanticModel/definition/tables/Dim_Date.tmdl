	column Year-Month
		lineageTag: 097c998b-aa08-45b2-85a3-b8719b4f5bb8
		summarizeBy: none
		isNameInferred
		sourceColumn: [Year-Month]

		annotation SummarizationSetBy = Automatic

	partition Dim_Date = calculated
		mode: import
		source =
				
				ADDCOLUMNS(
				    CALENDAR(DATE(2020, 1, 1), DATE(2025, 12, 31)),
				    "Year", YEAR([Date]),
				    "Month Name", FORMAT([Date], "MMMM", "en-US"),
				    "Month Number", MONTH([Date]),
				    "Quarter", "Q" & FORMAT([Date], "Q"),
				    "Year-Month", FORMAT([Date], "YYYY-MM")
				)

	annotation PBI_Id = c502a5b7c77e49e7bc20aaa4cdba986e

